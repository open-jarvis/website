---
import { site } from '../config/site';
import BrandDownloads from './BrandDownloads.astro';

const links = [
  { label: 'GitHub', href: site.links.github, ext: true },
  { label: 'Docs', href: site.links.docs, ext: true },
  { label: 'Discord', href: site.links.discord, ext: true },
  { label: 'Paper', href: site.links.paper, ext: true },
  { label: 'Releases', href: site.links.releases, ext: true },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <BrandDownloads id="brand-dl-footer" placement="up">
      <img class="footer-mark" src="/logo-mark.svg" alt="" width="26" height="26" aria-hidden="true" />
      <span class="footer-brand-name">OpenJarvis</span>
    </BrandDownloads>

    <nav class="footer-nav" aria-label="Footer">
      {links.map((l, i) => (
        <>
          {i > 0 && <span class="footer-sep" aria-hidden="true">·</span>}
          <a href={l.href} {...l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{l.label}</a>
        </>
      ))}
    </nav>

    <p class="footer-copy">&copy; {new Date().getFullYear()} OpenJarvis Contributors · Apache-2.0</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); padding: 2.5rem 0; }
  .footer-inner { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
  .footer-brand-name { font-size: 1rem; font-weight: 600; letter-spacing: -.04em; }
  .footer-mark { width: 26px; height: 26px; }
  .footer-nav { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; font-size: .78rem; }
  .footer-nav a { color: var(--color-text-secondary); }
  .footer-nav a:hover { color: var(--color-accent); }
  .footer-sep { color: #a9afa4; }
  .footer-copy { width: 100%; margin: 0; font-size: .7rem; color: var(--color-text-tertiary); }
</style>
