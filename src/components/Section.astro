---
interface Props {
  id: string;
  title: string;
  index?: number;
  kicker?: string;
  link?: string;
  linkText?: string;
  external?: boolean;
}
const { id, title, kicker, link, linkText, external } = Astro.props;
---
<section id={id} class="section">
  <div class="container">
    <div class="section-header">
      <div>
        {kicker && <p class="section-kicker">{kicker}</p>}
        <h2 class="section-title">{title}</h2>
      </div>
      {link && <a class="section-link" href={link} {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{linkText ?? 'View all'} <span aria-hidden="true">↗</span></a>}
    </div>
    <slot />
  </div>
</section>
