---
import Section from './Section.astro';
import { site } from '../config/site';

// Real engines, runtimes and protocols OpenJarvis supports (from the docs).
const engines = ['Ollama', 'vLLM', 'SGLang', 'llama.cpp', 'Cloud APIs'];
const hardware = ['Apple Silicon', 'NVIDIA', 'AMD', 'NPUs', 'CPUs'];
const protocols = ['MCP servers', 'OpenAI-compatible API', 'Web search', 'Code interpreter', 'Retrieval'];
---

<Section id="works-with" title="Runs on your stack" index={3} link={site.links.docs} linkText="See all backends" external>
  <p class="ww-intro">
    OpenJarvis auto-detects your hardware and recommends the best-fit engine. The same code runs
    entirely on your machine or routes selectively to the cloud.
  </p>

  <div class="ww-panel">
    <div class="ww-col">
      <span class="ww-label">Engines</span>
      <div class="ww-pills">
        {engines.map((name) => (
          <span class="pill"><span class="pill-dot" aria-hidden="true"></span>{name}</span>
        ))}
      </div>
    </div>

    <div class="ww-col">
      <span class="ww-label">Hardware</span>
      <div class="ww-pills">
        {hardware.map((name) => (
          <span class="pill pill-amber"><span class="pill-dot" aria-hidden="true"></span>{name}</span>
        ))}
      </div>
    </div>

    <div class="ww-col">
      <span class="ww-label">Tools &amp; protocols</span>
      <div class="ww-pills">
        {protocols.map((name) => (
          <span class="pill"><span class="pill-dot" aria-hidden="true"></span>{name}</span>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  .ww-intro { max-width: 64ch; font-size: 1rem; margin: -1rem 0 2rem; }
  .ww-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .ww-col { padding-top: 1.25rem; border-top: 2px solid #adc6e8; }
  .ww-col:nth-child(2) { border-top-color: #b7cba6; }
  .ww-col:nth-child(3) { border-top-color: #c5c0df; }
  .ww-label { display: block; color: var(--color-text); font-size: .95rem; font-weight: 600; margin-bottom: 1rem; }
  .ww-pills { display: flex; flex-wrap: wrap; gap: .55rem; }
  .pill { padding: .35rem .7rem; border: 1px solid var(--color-border); border-radius: 4px; background: #fff; color: var(--color-text-secondary); font-size: .8rem; }
  .pill-dot { display: none; }
  @media (max-width: 760px) { .ww-panel { grid-template-columns: 1fr; gap: 1.75rem; } }
</style>
