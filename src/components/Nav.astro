---
import { site } from '../config/site';
import BrandDownloads from './BrandDownloads.astro';

// Shared by the inline row and the small-screen dropdown so they can't drift.
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Showcase', href: '#showcase' },
  { label: 'Community', href: '#community' },
  { label: 'Docs', href: site.links.docs, ext: true },
];
---

<header class="site-topbar">
  <div class="container topbar-inner">
    <BrandDownloads id="brand-dl-nav" placement="down">
      <img class="brand-mark" src="/logo-mark.svg" alt="" width="28" height="28" aria-hidden="true" />
      <span class="brand-name">OpenJarvis</span>
    </BrandDownloads>

    <nav class="topbar-nav" aria-label="Main navigation">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class="topbar-link"
          {...l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >{l.label}</a>
      ))}
    </nav>

    <div class="topbar-actions">
      <a href={site.links.github} class="ghbtn" data-repo={site.links.github} target="_blank" rel="noopener noreferrer" aria-label="Star OpenJarvis on GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path>
        </svg>
        <span class="ghbtn-label">Star</span>
        <span class="ghbtn-stars" hidden aria-hidden="true"></span>
      </a>

      <div class="menu-wrap">
        <button
          id="nav-menu-toggle"
          class="menu-btn"
          type="button"
          aria-label="Open navigation menu"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="nav-menu-panel"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>

        <nav id="nav-menu-panel" class="menu-panel" aria-label="Main navigation" hidden>
          {navLinks.map((l) => (
            <a
              href={l.href}
              class="menu-link"
              {...l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            >{l.label}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('nav-menu-toggle');
  const menuPanel = document.getElementById('nav-menu-panel');
  if (menuBtn && menuPanel) {
    const setOpen = (open: boolean) => {
      menuPanel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
    };

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menuPanel.hidden);
    });

    // Jump links only change the hash, so close on select.
    menuPanel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menuPanel.hidden && !menuPanel.contains(t) && !menuBtn.contains(t)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menuPanel.hidden) {
        setOpen(false);
        menuBtn.focus();
      }
    });

    // The inline row takes over above the breakpoint; don't leave the panel open.
    matchMedia('(min-width: 861px)').addEventListener('change', (ev) => {
      if (ev.matches) setOpen(false);
    });
  }

  const ghLink = document.querySelector<HTMLAnchorElement>('.ghbtn');
  const starEl = document.querySelector<HTMLElement>('.ghbtn-stars');
  if (ghLink && starEl) {
    const slug = (ghLink.dataset.repo ?? '')
      .replace(/^https?:\/\/github\.com\//, '')
      .replace(/\/$/, '');
    if (slug.split('/').length === 2) {
      fetch(`https://api.github.com/repos/${slug}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          const n = d && d.stargazers_count;
          if (typeof n === 'number') {
            starEl.textContent = n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
            starEl.hidden = false;
            starEl.removeAttribute('aria-hidden');
          }
        })
        .catch(() => {});
    }
  }
</script>

<style>
  .site-topbar { position: sticky; top: 0; z-index: 90; background: #ffffffed; backdrop-filter: blur(16px); border-bottom: 1px solid var(--color-border); }
  .topbar-inner { display: flex; align-items: center; gap: 1.5rem; height: 68px; }
  .brand-mark { width: 32px; height: 32px; }
  .brand-name { font-size: 1.12rem; font-weight: 600; letter-spacing: -.045em; color: var(--color-text); }
  .topbar-nav { display: flex; align-items: center; gap: 1.8rem; margin-left: auto; }
  .topbar-link { font-size: .86rem; color: var(--color-text-secondary); }
  .topbar-link:hover { color: var(--color-accent); }
  .topbar-actions { display: flex; align-items: center; gap: .6rem; flex-shrink: 0; }
  .ghbtn { display: inline-flex; align-items: center; gap: .5rem; min-height: 36px; padding: 0 .7rem; border: 1px solid var(--color-border); border-radius: 5px; color: var(--color-text); font-size: .76rem; }
  .ghbtn:hover { background: var(--color-bg-alt); color: var(--color-text); }
  .ghbtn-stars { padding-left: .5rem; border-left: 1px solid var(--color-border); font-variant-numeric: tabular-nums; color: var(--color-text-secondary); }
  .menu-wrap { position: relative; display: none; }
  .menu-btn { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--color-border); border-radius: 5px; background: transparent; color: var(--color-text); cursor: pointer; }
  .menu-panel { position: absolute; top: calc(100% + .7rem); right: 0; display: flex; flex-direction: column; gap: .25rem; min-width: 12rem; padding: .5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: 0 10px 30px #24344315; }
  .menu-link { font-size: .9rem; padding: .65rem .8rem; color: var(--color-text); border-radius: 3px; }
  .menu-link:hover { background: var(--color-bg-alt); color: var(--color-accent); }
  @media (max-width: 860px) { .topbar-nav { display: none; } .topbar-actions { margin-left: auto; } .menu-wrap { display: block; } }
  @media (max-width: 480px) { .topbar-inner { height: 65px; gap: 1rem; } .brand-name { font-size: 1.04rem; } .brand-mark { width: 28px; height: 28px; } .ghbtn-label { display: none; } .ghbtn { padding-inline: .55rem; } }
</style>
