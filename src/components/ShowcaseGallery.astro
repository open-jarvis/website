---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import { site } from '../config/site';
const items = (await getCollection('showcase')).sort((a, b) => a.data.order - b.data.order);
const coding = items.find(item => item.data.order === 1)!;
const morning = items.find(item => item.data.order === 4)!;
const more = items.filter(item => ![1, 4].includes(item.data.order));
const href = (id: string) => `${site.links.docs}showcase/${id}/`;
---
<Section id="showcase" title="See it in action" link="#community" linkText="Build your own">
  <div class="showcase-featured">
    <a href={href(coding.id)} class="recipe recipe-code" target="_blank" rel="noopener noreferrer">
      <div class="recipe-art code-art" aria-hidden="true"><span class="art-label">{coding.data.title}</span><div class="file-tree"><span>project/</span><span>├─ src/</span><span>├─ tests/</span><span>└─ README.md</span></div><div class="code-action"><span>Read</span><span>Reason</span><span>Edit <span>↗</span></span></div></div>
      <div class="recipe-copy"><h3>{coding.data.title}<span aria-hidden="true">↗</span></h3><p>{coding.data.summary}</p></div>
    </a>
    <a href={href(morning.id)} class="recipe recipe-morning" target="_blank" rel="noopener noreferrer">
      <div class="recipe-art morning-art" aria-hidden="true"><span class="art-label">{morning.data.title}</span><div class="brief-sources"><span>Calendar</span><span>Email</span><span>News</span></div><div class="brief-lines"><i></i><i></i><i></i></div><span class="brief-output">{morning.data.title} <span>↗</span></span></div>
      <div class="recipe-copy"><h3>{morning.data.title}<span aria-hidden="true">↗</span></h3><p>{morning.data.summary}</p></div>
    </a>
  </div>
  <div class="more-recipes">
    {more.map(item => <a href={href(item.id)} target="_blank" rel="noopener noreferrer"><h3>{item.data.title}<span aria-hidden="true">↗</span></h3><p>{item.data.summary}</p></a>)}
  </div>
</Section>
<style>
  .showcase-featured { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
  .recipe { display: block; border: 1px solid #dce4ee; border-radius: 8px; overflow: hidden; color: var(--color-text); }
  .recipe:hover { border-color: #8aa7ce; color: var(--color-text); }
  .recipe-art { height: 214px; position: relative; padding: 25px 32px; overflow: hidden; }
  .art-label { font-family: var(--font-mono); font-size: .6rem; color: #667992; }
  .code-art { background: #eef3fb; }
  .file-tree { display: flex; flex-direction: column; padding: 20px 0 0 10px; font-family: var(--font-mono); font-size: .84rem; line-height: 1.8; color: #6380a7; }
  .file-tree > span:first-child { color: #335680; }
  .code-action { display: flex; flex-direction: column; gap: 10px; position: absolute; top: 67px; right: 48px; width: 110px; }
  .code-action > span { padding: 7px 12px; background: #fff; border: 1px solid #d7e2f0; border-radius: 4px; font-size: .7rem; color: #5c7698; }
  .code-action > span:last-child { background: #dce8fb; border-color: #bcd0ed; color: #315f9d; }
  .code-action span span { float: right; }
  .morning-art { background: #f3f5eb; }
  .brief-sources { display: flex; gap: 10px; margin-top: 25px; }
  .brief-sources span { padding: 7px 14px; background: #fff; border: 1px solid #dce1ce; border-radius: 4px; color: #7b8a63; font-size: .7rem; }
  .brief-lines { display: flex; flex-direction: column; gap: 8px; margin-top: 18px; max-width: 320px; }
  .brief-lines i { height: 4px; background: #dce2cf; width: 100%; border-radius: 3px; }
  .brief-lines i:nth-child(2) { width: 88%; }
  .brief-lines i:nth-child(3) { width: 63%; }
  .brief-output { position: absolute; bottom: 22px; left: 32px; right: 32px; font-family: var(--font-serif); font-size: 1.1rem; font-style: italic; color: #5f7550; }
  .brief-output span { float: right; font-family: var(--font-sans); }
  .recipe-copy { padding: 27px 30px 25px; }
  .recipe-category { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .04em; color: #74859b; }
  .recipe-copy h3 > span { float: right; color: #7f96b2; font-size: .9rem; }
  .recipe-copy h3 { font-size: 1.33rem; letter-spacing: -.03em; font-weight: 500; margin: 11px 0 12px; }
  .recipe-copy p { font-size: .88rem; line-height: 1.75; min-height: 3em; }
  .recipe-link { display: flex; justify-content: space-between; margin-top: 22px; font-size: .76rem; color: #315f9d; }
  .more-recipes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 40px; }
  .more-recipes a { border-top: 1px solid #dfe6ee; padding-top: 22px; }
  .more-recipes h3 { display: flex; justify-content: space-between; font-size: 1rem; font-weight: 500; margin-bottom: 14px; }
  .more-recipes h3 > span { color: #7f96b2; font-size: .9rem; }
  .more-recipes p { font-size: .84rem; line-height: 1.8; margin-bottom: 15px; }
  .more-label { font-size: .72rem; }
  @media (max-width: 760px) { .showcase-featured { grid-template-columns: 1fr; } .more-recipes { grid-template-columns: 1fr; gap: 24px; } .recipe-art { padding-inline: 24px; } .recipe-copy { padding: 24px; } }
  @media (max-width: 400px) { .code-action { right: 24px; width: 90px; } .file-tree { font-size: .74rem; padding-left: 0; } .brief-sources { gap: 6px; } .brief-sources span { padding-inline: 10px; } }
</style>
