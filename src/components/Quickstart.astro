---
import { site } from '../config/site';
const steps = [
  { id: 'install', label: 'Install', number: '01', code: ['# One command — installs everything for your hardware', site.install], copy: site.install },
  { id: 'ask', label: 'Ask', number: '02', code: ['# One-time setup & local model pull', 'jarvis init', 'jarvis ask "what\'s on my calendar today?"', '→ answered locally on your GPU · 0 cloud calls · 1.2s'], copy: 'jarvis init\njarvis ask "what\'s on my calendar today?"' },
  { id: 'serve', label: 'Serve', number: '03', code: ['# Expose an OpenAI-compatible API', 'jarvis serve', '→ live at http://localhost:8000'], copy: 'jarvis serve' },
];
---
<section id="quickstart" class="quickstart">
  <div class="container">
    <div class="walkthrough">
      <div class="walkthrough-top"><h2>Quick Start</h2><a href={site.links.docs} target="_blank" rel="noopener noreferrer">Read the full docs <span aria-hidden="true">↗</span></a></div>
      <div class="walkthrough-tabs" role="tablist" aria-label="Quickstart steps">
        {steps.map((step, i) => <button id={`qs-tab-${step.id}`} role="tab" aria-controls={`qs-panel-${step.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-step={step.id}><span>{step.number}</span>{step.label}<span class="step-arrow" aria-hidden="true">→</span></button>)}
      </div>
      {steps.map((step, i) => <div id={`qs-panel-${step.id}`} class="walkthrough-panel" role="tabpanel" aria-labelledby={`qs-tab-${step.id}`} tabindex="0" hidden={i !== 0}>
        <div class="walkthrough-explanation"><p>Runs entirely on your hardware — cloud APIs are optional. Browse and pull local models any time with <code>jarvis model</code>.</p></div>
        <div class="code-example"><div class="code-title"><span>terminal</span><button data-copy={step.copy} aria-label={`Copy ${step.label.toLowerCase()} commands`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V3H3v13h5"/></svg><span class="copy-label">Copy</span></button></div><pre><code>{step.code.map((line, lineIndex) => <span class:list={['code-line', line.startsWith('#') && 'comment']}><span class="line-number" aria-hidden="true">{lineIndex + 1}</span><span>{line || ' '}</span></span>)}</code></pre></div>
      </div>)}
    </div>
  </div>
</section>
<script>
  import { copyText } from '../lib/clipboard';
  const root = document.getElementById('quickstart');
  const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-step]') ?? []);
  function activate(tab: HTMLButtonElement) {
    tabs.forEach(t => { const active = t === tab; t.setAttribute('aria-selected', String(active)); t.tabIndex = active ? 0 : -1; });
    root?.querySelectorAll<HTMLElement>('.walkthrough-panel').forEach(panel => { panel.hidden = panel.id !== `qs-panel-${tab.dataset.step}`; });
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', event => {
      let next = i;
      if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (i + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault(); activate(tabs[next]); tabs[next].focus();
    });
  });
  root?.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      if (!await copyText(button.dataset.copy ?? '')) return;
      const label = button.querySelector('.copy-label');
      if (label) { label.textContent = 'Copied'; setTimeout(() => label.textContent = 'Copy', 1600); }
    });
  });
</script>
<style>
  .quickstart { padding: 4px 0 70px; scroll-margin-top: 90px; }
  .walkthrough { border: 1px solid #d8e1ef; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 12px 40px -28px #274b7833; }
  .walkthrough-top { padding: 22px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .walkthrough-top h2 { font-size: 1.03rem; font-weight: 500; margin: 0; letter-spacing: -.02em; }
  .walkthrough-top a { font-size: .75rem; white-space: nowrap; }
  .walkthrough-tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--color-border); background: #f8fafd; }
  .walkthrough-tabs button { display: flex; align-items: center; gap: 14px; border: 0; border-bottom: 2px solid transparent; padding: 15px 28px; background: transparent; text-align: left; color: #6d7b90; font-size: .86rem; cursor: pointer; }
  .walkthrough-tabs button + button { border-left: 1px solid var(--color-border); }
  .walkthrough-tabs button > span:first-child { font-family: var(--font-mono); font-size: .67rem; opacity: .7; }
  .walkthrough-tabs button[aria-selected='true'] { background: #edf3fc; color: #315f9d; border-bottom-color: #315f9d; }
  .step-arrow { margin-left: auto; opacity: .7; }
  .walkthrough-panel { display: grid; grid-template-columns: .85fr 1.6fr; min-height: 220px; }
  .walkthrough-explanation { padding: 30px 28px; }
  .walkthrough-explanation h3 { font-size: 1.08rem; font-weight: 600; margin-bottom: 12px; }
  .walkthrough-explanation p { font-size: .86rem; line-height: 1.75; margin-bottom: 20px; }
  .step-note { font-size: .7rem; color: #667d69; }
  .step-note > span { margin-right: 4px; }
  .code-example { border-left: 1px solid var(--color-border); background: #f6f8fc; min-width: 0; }
  .code-title { display: flex; align-items: center; justify-content: space-between; padding: 14px 22px; font-family: var(--font-mono); font-size: .66rem; color: #7e8ba0; }
  .code-title button { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border: 1px solid #d6dfec; border-radius: 4px; background: #fff; font-size: .67rem; color: #58708f; cursor: pointer; }
  .code-title button:hover { border-color: var(--color-accent); }
  pre { background: transparent; margin: 0; padding: 9px 24px 25px; border: 0; font-size: .8rem; line-height: 2; color: #2b507f; }
  pre code { font-size: inherit; }
  .code-line { display: flex; gap: 22px; white-space: pre; }
  .line-number { min-width: 10px; flex-shrink: 0; color: #b0bbcb; user-select: none; font-size: .7rem; }
  .code-line.comment { color: #74856c; }
  @media (max-width: 760px) {
    .quickstart { padding-bottom: 48px; }
    .walkthrough-top { padding: 18px; align-items: start; }
    .walkthrough-top h2 { font-size: .9rem; max-width: 25ch; line-height: 1.5; }
    .walkthrough-top a { font-size: .65rem; padding-top: 3px; }
    .walkthrough-tabs button { padding: 13px 18px; gap: 9px; font-size: .8rem; }
    .walkthrough-panel { grid-template-columns: 1fr; }
    .walkthrough-explanation { padding: 24px; }
    .walkthrough-explanation p { margin-bottom: 12px; }
    .code-example { border-left: 0; border-top: 1px solid var(--color-border); }
    pre { font-size: .72rem; }
  }
  @media (max-width: 400px) { .step-arrow { display: none; } .walkthrough-tabs button { padding-inline: 14px; } .walkthrough-top { flex-direction: column; gap: 8px; } }
</style>
