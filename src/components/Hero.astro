---
import { site } from '../config/site';
---
<header class="hero">
  <div class="container hero-content">
    <h1><img src="/logo-mark.svg" alt="" width="76" height="76" /><span>OpenJarvis</span></h1>
    <p class="hero-tagline"><span>{site.tagline.split(", ")[0]},</span> <em>{site.tagline.split(", ").slice(1).join(", ")}</em></p>
    <p class="hero-description">{site.subhead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#quickstart">Get Started <span aria-hidden="true">→</span></a>
      <a class="btn btn-outline" href={site.links.github} target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.7-1.4-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.3 1.8 1.3 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 0Z"/></svg>View on GitHub</a>
    </div>
  </div>
</header>
<style>
  .hero {
    position: relative;
    padding: 52px 0 48px;
    text-align: center;
    background: radial-gradient(ellipse 60% 90% at 50% 10%, #eef5ff 0%, #f8fbff80 48%, transparent 85%);
  }
  .hero-content { position: relative; }
  h1 { display: flex; align-items: center; justify-content: center; gap: 18px; font-family: var(--font-sans); font-size: clamp(3.5rem, 7.2vw, 6rem); line-height: 1.1; font-weight: 700; letter-spacing: -.065em; margin: 0 0 20px; color: #1d3353; }
  h1 img { width: .85em; height: .85em; flex-shrink: 0; }
  .hero-tagline { margin-bottom: 18px; font-family: var(--font-serif); font-size: clamp(1.65rem, 3.15vw, 2.65rem); line-height: 1.3; letter-spacing: -.045em; color: #2d3e58; }
  .hero-tagline em { font-weight: 400; color: #476e9c; }
  .hero-description { font-size: 1.06rem; line-height: 1.75; color: #5a6677; margin: 0 auto 25px; max-width: 730px; }
  .hero-actions { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .hero-actions .btn { min-width: 145px; min-height: 48px; }
  .hero-principles { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0; font-size: .72rem; color: #6b7686; margin-top: 22px; }
  .hero-principles span + span::before { content: '·'; padding-inline: 13px; color: #9eabbb; }
  @media (max-width: 480px) {
    .hero-actions { display: flex; max-width: 340px; margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .hero { padding: 40px 0 36px; }
    h1 { gap: 10px; font-size: clamp(2.85rem, 10.8vw, 4.2rem); margin-bottom: 22px; }
    .hero-tagline { font-size: clamp(1.55rem, 5.8vw, 2rem); max-width: 320px; margin-inline: auto; }
    .hero-description { font-size: .96rem; margin-bottom: 22px; }
    .desktop-break { display: none; }
    .hero-actions { gap: 9px; }
    .hero-actions .btn { min-width: 0; padding: .7rem .7rem; font-size: .78rem; min-height: 44px; gap: .5rem; white-space: nowrap; }
    .hero-actions .btn svg { width: 16px; height: 16px; }
    .hero-tagline em { display: block; }
    .hero-principles { font-size: .64rem; row-gap: 5px; }
    .hero-principles span + span::before { padding-inline: 7px; }
  }
</style>
